# Required: use a fine-grained GitHub token restricted to a separate PRIVATE session repository.
# Grant Contents: Read and write, plus Metadata: Read-only.
GITHUB_TOKEN=replace_with_your_github_token
GITHUB_REPO=your-github-username/your-private-session-repo
GITHUB_BRANCH=main
ADMIN_API_KEY=replace_with_a_random_64_character_hex_value

# Strongly recommended: digits with country code, no leading +; multiple numbers comma-separated.
OWNER_NUMBER=your_number_with_country_code
OWNER_NAME=Your Name
BOT_NAME=Mani Mini Bot

# Optional server settings
PORT=8000
PREFIX=.

# Keep automation disabled until you have reviewed and set your own channel and preferences.
CHANNEL_JID=your-channel-id@newsletter
AUTO_FOLLOW_CHANNEL=false
AUTO_CHANNEL_REACT=false
AUTO_STATUS_SEEN=false
AUTO_STATUS_REACT=false

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
